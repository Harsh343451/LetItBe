<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Shops - LetItBe</title>

    <link rel="stylesheet" href="/output.css">
</head>

<body class="bg-gray-50 min-h-screen">

    <%- include('./partials/navbar') %>

    <main class="max-w-7xl mx-auto px-6 py-10">

        <!-- Header -->
        <div class="flex flex-col md:flex-row md:items-center md:justify-between mb-10">

            <div>
                <h1 class="text-3xl font-bold text-gray-800">
                    My Shops
                </h1>

                <p class="text-gray-600 mt-2">
                    Manage all the shops you have added.
                </p>
            </div>

            <a href="/add-shop"
               class="mt-4 md:mt-0 inline-flex items-center bg-blue-600 text-white px-5 py-3 rounded-lg hover:bg-blue-700 transition font-semibold">

                <span class="mr-2">+</span>
                Add New Shop
            </a>
        </div>

        <!-- No Shops State -->
        <% if (shops.length === 0) { %>

            <div class="bg-white rounded-xl shadow p-10 text-center">

                <h2 class="text-2xl font-bold text-gray-800 mb-3">
                    No Shops Added Yet
                </h2>

                <p class="text-gray-600 mb-6">
                    Start by creating your first shop.
                </p>

                <a href="/add-shop"
                   class="bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition font-semibold">

                    Add Shop
                </a>

            </div>

        <% } else { %>

        <!-- Shops Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

            <% shops.forEach(shop => { %>

                <div class="bg-white rounded-xl shadow hover:shadow-lg transition overflow-hidden">

                    <!-- Card Content -->
                    <div class="p-6">

                        <!-- Shop Name -->
                        <div class="flex items-start justify-between mb-4">

                            <div>
                                <h2 class="text-xl font-bold text-gray-800">
                                    <%= shop.shopName %>
                                </h2>

                                <p class="text-sm text-gray-500 mt-1">
                                    <%= shop.address %>
                                </p>
                            </div>

                            <div class="bg-blue-100 text-blue-700 text-xs font-bold px-3 py-1 rounded-full">
                                Active
                            </div>
                        </div>

                        <!-- Description -->
                        <p class="text-gray-600 text-sm mb-5 line-clamp-3">
                            <%= shop.description || "No description added." %>
                        </p>

                        <!-- Services -->
                        <div class="mb-5">

                            <h3 class="text-sm font-semibold text-gray-700 mb-2">
                                Services
                            </h3>

                            <div class="flex flex-wrap gap-2">

                                <% shop.services.forEach(service => { %>

                                    <span class="bg-gray-100 text-gray-700 text-xs px-3 py-1 rounded-full">
                                        <%= service %>
                                    </span>

                                <% }) %>

                            </div>
                        </div>

                        <!-- Contact -->
                        <div class="space-y-2 text-sm text-gray-600 mb-6">

                            <p>
                                📞 <%= shop.phone %>
                            </p>

                            <p>
                                ✉️ <%= shop.email %>
                            </p>

                            <% if (shop.openingHours) { %>

                                <p>
                                    🕒 <%= shop.openingHours %>
                                </p>

                            <% } %>

                        </div>

                        <!-- Actions -->
                        <div class="flex gap-3">

                            <a href="#"
                               class="flex-1 bg-blue-600 text-white text-center py-2 rounded-lg hover:bg-blue-700 transition font-medium">

                                Manage
                            </a>

                            <form method="POST" action="/delete-shop/<%= shop._id %>" class="flex-1">
                                <button type="submit" onclick="return confirm('Are you sure you want to delete this shop?')" class="w-full border border-red-500 text-red-500 text-center py-2 rounded-lg hover:bg-red-50 transition font-medium">
                                    Delete
                                </button>
                            </form>

                        </div>

                    </div>

                </div>

            <% }) %>

        </div>

        <% } %>

    </main>

</body>
</html>