  <!-- Navbar -->
  <nav class="bg-white shadow">
    <div class="max-w-7xl mx-auto px-6 py-4 flex justify-between items-center">
      <h1 class="text-2xl font-bold text-blue-600">LetItBe</h1>
      
      <!-- Desktop Navigation -->
      <% if (!isLoggedIn) { %>
        <!-- Not Logged In - Desktop -->
        <div class="hidden md:flex space-x-4">
          <a href="/login" class="text-gray-600 hover:text-blue-600 transition">Login</a>
          <a href="/signup"
             class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 transition">
            Get Started
          </a>
        </div>
        
        <!-- Not Logged In - Mobile Menu Button -->
        <button id="mobileMenuBtn" class="md:hidden text-gray-600 hover:text-blue-600">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      <% } else { %>
        <!-- Logged In - Desktop -->
        <div class="hidden md:flex items-center space-x-6">
          <!-- User Profile -->
          <div class="flex items-center space-x-3">
            <!-- Initials Circle Badge -->
            <%
              const initials = user.name
                .split(' ')
                .map(n => n[0])
                .join('')
                .toUpperCase()
                .substring(0, 2);
            %>
            <div class="w-10 h-10 bg-blue-600 text-white rounded-full flex items-center justify-center font-bold text-sm">
              <%= initials %>
            </div>
            <span class="text-gray-700 font-medium"><%= user.name %></span>
          </div>
          
          <!-- Dashboard Link -->
          <a href="/dashboard" class="text-gray-600 hover:text-blue-600 transition">Dashboard</a>
          
          <!-- Logout Form -->
          <form action="/logout" method="POST" class="inline">
            <button type="submit" class="bg-red-600 text-white px-4 py-2 rounded hover:bg-red-700 transition">
              Logout
            </button>
          </form>
        </div>
        
        <!-- Logged In - Mobile Menu Button -->
        <button id="mobileMenuBtn" class="md:hidden text-gray-600 hover:text-blue-600">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      <% } %>
    </div>
    
    <!-- Mobile Menu -->
    <div id="mobileMenu" class="hidden md:hidden bg-gray-50 border-t">
      <div class="px-6 py-4 space-y-3">
        <% if (!isLoggedIn) { %>
          <a href="/login" class="block text-gray-600 hover:text-blue-600 py-2">Login</a>
          <a href="/signup" class="block bg-blue-600 text-white px-4 py-2 rounded text-center hover:bg-blue-700">
            Get Started
          </a>
        <% } else { %>
          <!-- Mobile Profile Display -->
          <div class="flex items-center space-x-3 py-2 border-b">
            <%
              const initials = user.name
                .split(' ')
                .map(n => n[0])
                .join('')
                .toUpperCase()
                .substring(0, 2);
            %>
            <div class="w-10 h-10 bg-blue-600 text-white rounded-full flex items-center justify-center font-bold text-sm">
              <%= initials %>
            </div>
            <span class="text-gray-700 font-medium"><%= user.name %></span>
          </div>
          
          <a href="/dashboard" class="block text-gray-600 hover:text-blue-600 py-2">Dashboard</a>
          
          <form action="/logout" method="POST">
            <button type="submit" class="w-full bg-red-600 text-white px-4 py-2 rounded text-left hover:bg-red-700">
              Logout
            </button>
          </form>
        <% } %>
      </div>
    </div>
  </nav>

  <script>
    // Mobile menu toggle
    const mobileMenuBtn = document.getElementById('mobileMenuBtn');
    const mobileMenu = document.getElementById('mobileMenu');
    
    if (mobileMenuBtn) {
      mobileMenuBtn.addEventListener('click', () => {
        mobileMenu.classList.toggle('hidden');
      });
    }
  </script>